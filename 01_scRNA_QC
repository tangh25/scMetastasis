##双细胞预测
# 将原始数据保存为adata.raw方便后面需要时调用。
adata.raw = adata  #不做周期检测运行
#导入库，并进行预测
import scrublet as scr
scrub = scr.Scrublet(adata.raw.X, expected_doublet_rate=0.06)   #预期多细胞的比率，通常为0.05-0.1。 结果对该参数不是特别敏感
result = scrub.scrub_doublets(verbose=False, n_prin_comps = 20)

scrub.plot_histogram()
#将预测结果添加到adata.obs中
adata.obs['doublet_scores'] = result[0]
adata.obs['predicted_doublets'] = result[1]

#统计双细胞数目并可视化双细胞和总counts数之间关系

adata.obs.predicted_doublets.value_counts()
adata.obs['predicted_doublets'] = adata.obs["predicted_doublets"].astype(str)

sc.pl.violin(adata, 'n_genes_by_counts',jitter=0.4, groupby = 'predicted_doublets',show=False)
plt.savefig('./GSE156625/GSE156625_predicted_doublets_violin_plot.pdf', bbox_inches='tight')

